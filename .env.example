# Copy to .env and change what you need. Every setting has a default.
PIPELINE_APP_NAME=Transcription Pipeline

# Where uploads, converted audio and the job database are kept
PIPELINE_DATA_DIR=data

# Upload limits
PIPELINE_MAX_UPLOAD_MB=500
PIPELINE_MAX_DURATION_MINUTES=60

# Speech-to-text engine (faster-whisper)
# Model: tiny, base, small, medium, large-v3, large-v3-turbo
PIPELINE_MODEL_SIZE=large-v3-turbo
PIPELINE_MODEL_DIR=models
# auto picks the GPU when one is available, otherwise the CPU
PIPELINE_DEVICE=auto
# auto = float16 on GPU, int8 on CPU
PIPELINE_COMPUTE_TYPE=auto
PIPELINE_BEAM_SIZE=5

# Background jobs
PIPELINE_WORKERS=1
PIPELINE_MAX_PENDING_JOBS=20
PIPELINE_MAX_ATTEMPTS=3

# A gap between segments at least this long is reported as a pause
PIPELINE_PAUSE_THRESHOLD_SECONDS=1.5
